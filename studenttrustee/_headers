# Netlify reads this at build time and turns it into response headers.
# It is never served as a file, so it cannot be recovered from the live site:
# this copy in the repo is the only one.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://services.arcgisonline.com; connect-src 'self' https://nbonasera.github.io; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Speculation-Rules: "/speculation-rules.json"

# Document prefetch rules for Chromium browsers (other browsers ignore them): links to the site's
# other pages are fetched when the pointer rests on them. The Legislation section routes its own
# links and prefetches their records itself, so its deep links are left out.
/speculation-rules.json
  Content-Type: application/speculationrules+json; charset=utf-8
  Cache-Control: public, max-age=3600

# The Legislation pages build every element with DOM calls and never parse an HTML string, so
# they enforce Trusted Types: any HTML string sink (innerHTML and the like) throws instead of
# running. The whole site policy is repeated because this rule's header replaces the one above
# (Netlify applies every matching rule, the later one winning for the same header).
/legislation/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://services.arcgisonline.com; connect-src 'self' https://nbonasera.github.io; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'

# Vendored libraries live in versioned folders (vendor/leaflet-1.9.4), so they can be cached hard.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Fingerprinted brand assets. The -p6 suffix changes when the art changes,
# so these can be cached hard.
/brand/*
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# The roster changes. Let a crawler or a browser re-check rather than sit on
# a stale trustee for a week.
/districts/*
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

# The roster and site data. (Legislation records are not served from here: the nightly job
# publishes them to GitHub Pages from the data branch, so a refresh is never a Netlify deploy.)
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# District boundaries change about once a year.
/data/districts.geojson
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
