{
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "require-sri": ["error", { "target": "crossorigin" }],
    "no-implicit-button-type": "error",
    "prefer-native-element": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error"
  }
}
